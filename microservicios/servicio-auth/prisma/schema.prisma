generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id_usuario     Int      @id @default(autoincrement())
  nombre_usuario String
  correo         String   @unique
  contrasena     String
  rol            String   // 'Director', 'Maestro' o 'Alumno'
  id_alumno      Int?     // Vinculo con el registro de alumno en servicio-estudiantes
  fecha_creacion DateTime @default(now())
}
