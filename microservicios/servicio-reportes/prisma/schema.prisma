generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Modelos de lectura - el servicio de reportes consulta las tablas creadas por otros servicios
model Asistencia {
  id_asistencia  Int      @id @default(autoincrement())
  id_alumno      Int
  id_salon       Int
  fecha          DateTime @db.Date
  estado         String
  observacion    String?
  registrado_por Int
  fecha_registro DateTime @default(now())

  @@unique([id_alumno, fecha])
}

model Alumno {
  id_alumno      Int      @id @default(autoincrement())
  nombre         String
  apellido       String
  fecha_creacion DateTime @default(now())
  id_salon       Int
}

model Salon {
  id_salon   Int    @id @default(autoincrement())
  grado      String
  seccion    String
  id_maestro Int

  @@unique([grado, seccion])
}
